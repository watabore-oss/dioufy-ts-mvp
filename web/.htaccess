# ----------------------------------------------------------------------
# Configuration Apache / cPanel - Dioufy-TS (https://dioufy-ts.sn/)
# ----------------------------------------------------------------------

# 1. Forcer la redirection HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 2. Routage Single Page Application (PWA / Flutter Web)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# 3. Types MIME corrects pour Flutter Web & WebAssembly
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType application/wasm .wasm
  AddType image/svg+xml .svg
</IfModule>

# 4. Compression Gzip / Deflate pour performances mobiles maximales
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/wasm image/svg+xml
</IfModule>

# 5. Gestion du Cache HTTP
<IfModule mod_headers.c>
  # Ne jamais cacher index.html et flutter_service_worker.js pour garantir les mises à jour en direct
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "flutter_service_worker\.js$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cacher les ressources statiques pendant 1 an (images, polices, wasm)
  <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg|wasm|ttf|otf|woff|woff2)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
