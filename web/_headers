# ----------------------------------------------------------------------
# En-têtes HTTP de Sécurité et Mise en Cache - Cloudflare Pages
# Dioufy-TS Production
# ----------------------------------------------------------------------

# En-têtes globaux de sécurité
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=()

# Fichiers d'amorçage PWA et HTML (aucun cache pour mise à jour instantanée)
/index.html
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

/flutter_service_worker.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

/flutter_bootstrap.js
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

/version.json
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate

/manifest.json
  Cache-Control: max-age=0, no-cache, no-store, must-revalidate


# Ressources statiques immuables (mise en cache CDN 1 an)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

# Icônes et logos : revalidation fréquente pour moteurs de recherche (Google, Bing)
/icons/*
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.ico
  Cache-Control: public, max-age=3600, must-revalidate

/favicon.png
  Cache-Control: public, max-age=3600, must-revalidate

/logo.png
  Cache-Control: public, max-age=3600, must-revalidate

